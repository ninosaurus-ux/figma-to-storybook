{
  "global": {
    "color": {
      "brand": {
        "50": {
          "$type": "color",
          "$value": "#eff6ff"
        },
        "100": {
          "$type": "color",
          "$value": "#dbeafe"
        },
        "500": {
          "$type": "color",
          "$value": "#2563eb",
          "$description": "warna utama"
        },
        "600": {
          "$type": "color",
          "$value": "#1d4ed8"
        },
        "700": {
          "$type": "color",
          "$value": "#1e40af"
        },
        "900": {
          "$type": "color",
          "$value": "#1e3a8a"
        }
      },
      "neutral": {
        "0": {
          "$type": "color",
          "$value": "#ffffff"
        },
        "100": {
          "$type": "color",
          "$value": "#f3f4f6"
        },
        "500": {
          "$type": "color",
          "$value": "#6b7280"
        },
        "900": {
          "$type": "color",
          "$value": "#111827"
        },
        "1000": {
          "$type": "color",
          "$value": "#000000"
        }
      }
    },
    "spacing": {
      "1": {
        "$type": "spacing",
        "$value": "4"
      },
      "2": {
        "$type": "spacing",
        "$value": "8"
      },
      "3": {
        "$type": "spacing",
        "$value": "12"
      },
      "4": {
        "$type": "spacing",
        "$value": "16"
      },
      "5": {
        "$type": "spacing",
        "$value": "24"
      },
      "6": {
        "$type": "spacing",
        "$value": "32"
      }
    },
    "radius": {
      "sm": {
        "$type": "borderRadius",
        "$value": "4"
      },
      "md": {
        "$type": "borderRadius",
        "$value": "8"
      },
      "lg": {
        "$type": "borderRadius",
        "$value": "16"
      }
    },
    "font": {
      "size": {
        "sm": {
          "$type": "fontSizes",
          "$value": "12"
        },
        "md": {
          "$type": "fontSizes",
          "$value": "14"
        },
        "lg": {
          "$type": "fontSizes",
          "$value": "16"
        },
        "xl": {
          "$type": "fontSizes",
          "$value": "20"
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeights",
          "$value": "400"
        },
        "medium": {
          "$type": "fontWeights",
          "$value": "500"
        },
        "bold": {
          "$type": "fontWeights",
          "$value": "700"
        }
      }
    }
  },
  "semantic": {
    "color": {
      "background": {
        "primary": {
          "$type": "color",
          "$value": "#7c3ae2"
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.neutral.100}"
        },
        "inverse": {
          "$type": "color",
          "$value": "{color.neutral.900}"
        }
      },
      "border": {
        "subtle": {
          "$type": "color",
          "$value": "{color.neutral.100}"
        },
        "strong": {
          "$type": "color",
          "$value": "{color.neutral.500}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{color.neutral.1000}"
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.neutral.500}"
        },
        "on-brand": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        }
      }
    },
    "spacing": {
      "gap": {
        "sm": {
          "$type": "spacing",
          "$value": "{spacing.2}"
        },
        "md": {
          "$type": "spacing",
          "$value": "{spacing.4}"
        }
      }
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "global",
      "semantic"
    ]
  }
}